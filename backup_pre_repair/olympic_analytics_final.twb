  <dashboards>
    <dashboard name='GLOBAL OLYMPIC PERFORMANCE'>
      <style />
      <size maxheight='900' maxwidth='1400' minheight='700' minwidth='1000' />
      <datasources>
        <datasource caption='Olympic Games and Medal Results' name='federated.medal_analysis' />
      </datasources>
      <zones>
        <zone h='100000' id='1' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='96000' id='2' is-fixed='true' param='vert' type='layout-flow' w='98000' x='1000' y='2000'>
            <zone h='20000' id='3' name='Olympic Overview KPIs' w='98000' x='1000' y='2000' />
            <zone h='38000' id='4' param='horz' type='layout-flow' w='98000' x='1000' y='22000'>
              <zone h='38000' id='5' name='Top 10 Countries by Total Medals' w='49000' x='1000' y='22000' />
              <zone h='38000' id='6' name='Medal Distribution (Gold Silver Bronze)' w='49000' x='50000' y='22000' />
            </zone>
            <zone h='38000' id='7' param='horz' type='layout-flow' w='98000' x='1000' y='60000'>
              <zone h='38000' id='8' name='Medal Trends Across Editions' w='49000' x='1000' y='60000' />
              <zone h='38000' id='9' name='Summer vs Winter Performance' w='49000' x='50000' y='60000' />
            </zone>
          </zone>
        </zone>
      </zones>
      <devicelayouts />
      <simple-id uuid='{92E346B0-459B-4E0E-B16E-5E55DBD150EF}' />
    </dashboard>

    <dashboard name='Olympic Games Performance Story' type='storyboard'>
      <style />
      <size maxheight='850' maxwidth='1300' minheight='700' minwidth='1000' />
      <datasources>
        <datasource caption='Olympic Games and Medal Results' name='federated.medal_analysis' />
      </datasources>
      <zones>
        <zone h='100000' id='101' type='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='102' type='flipboard' w='100000' x='0' y='0'>
            <flipboard active-id='1' show-nav-arrows='true'>
              <story-points>
                <story-point caption='Scene 1: Global Olympic Overview — 6,025 Medals Across 18 Editions' captured-sheet='Olympic Overview KPIs' id='1' />
                <story-point caption='Scene 2: Leading Nations &amp; Podium Domination (Top 10 Countries)' captured-sheet='Top 10 Countries by Total Medals' id='2' />
