            </encodings>
          </pane>
        </panes>
        <rows>[federated.medal_analysis].[sum:total_medals:qk]</rows>
        <cols>[federated.medal_analysis].[none:season:nk]</cols>
      </table>
      <simple-id uuid='{56EC3A09-6936-4E16-AB89-C633533A79DC}' />
    </worksheet>

    <worksheet name='Host Nation Advantage'>
      <table>
        <view>
          <datasources>
            <datasource caption='Olympic Games and Medal Results' name='federated.medal_analysis' />
          </datasources>
          <datasource-dependencies datasource='federated.medal_analysis'>
            <column datatype='integer' name='[Calculation_HostNation_Fixed]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='IF [country] = [host_country] OR ([country] = &quot;Great Britain&quot; AND [host_country] = &quot;United Kingdom&quot;) THEN 1 ELSE 0 END' />
            </column>
            <column datatype='integer' name='[total_medals]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_HostNation_Fixed]' derivation='None' name='[none:Calculation_HostNation_Fixed:ok]' pivot='key' type='ordinal' />
            <column-instance column='[total_medals]' derivation='Sum' name='[sum:total_medals:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
          </pane>
        </panes>
        <rows>[federated.medal_analysis].[sum:total_medals:qk]</rows>
        <cols>[federated.medal_analysis].[none:Calculation_HostNation_Fixed:ok]</cols>
      </table>
      <simple-id uuid='{F73CEFFC-175D-48EA-82B2-91FF6B334A0A}' />
    </worksheet>

    <worksheet name='Athlete Biometrics by Sport'>
      <table>
        <view>
          <datasources>
            <datasource caption='Olympic Athletes' name='federated.athletes' />
          </datasources>
          <datasource-dependencies datasource='federated.athletes'>
            <column datatype='string' name='[Calculation_BMI_Category]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot; ELSEIF [bmi] &lt; 25.0 THEN &quot;Normal Weight&quot; ELSEIF [bmi] &lt; 30.0 THEN &quot;Overweight&quot; ELSE &quot;Obese&quot; END' />
            </column>
            <column datatype='integer' name='[height_cm]' role='measure' type='quantitative' />
            <column datatype='integer' name='[weight_kg]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_BMI_Category]' derivation='None' name='[none:Calculation_BMI_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[height_cm]' derivation='Avg' name='[avg:height_cm:qk]' pivot='key' type='quantitative' />
            <column-instance column='[weight_kg]' derivation='Avg' name='[avg:weight_kg:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.athletes].[none:Calculation_BMI_Category:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.athletes].[avg:weight_kg:qk]</rows>
        <cols>[federated.athletes].[avg:height_cm:qk]</cols>
      </table>
      <simple-id uuid='{CA73DEDA-1A57-4E1F-8C69-C9E8BE27B394}' />
    </worksheet>
