            <encodings>
              <color column='[federated.medal_analysis].[none:season:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.medal_analysis].[sum:total_medals:qk]</rows>
        <cols>[federated.medal_analysis].[none:year:ok]</cols>
      </table>
      <simple-id uuid='{2E4B7C0F-C998-432A-A6D4-FC86884E6733}' />
