<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2024.1.0' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <document-format-change-manifest>
    <AccessibleZoneTabOrder />
    <IntuitiveSorting />
    <MapboxVectorStylesAndLayers />
    <SheetIdentifierTracking />
    <WindowsPersistSimpleIdentifiers />
  </document-format-change-manifest>
  <preferences>
    <preference name='ui.encoding.shelf.height' value='24' />
    <preference name='ui.shelf.height' value='26' />
  </preferences>
  <datasources>
    <datasource caption='Olympic Games and Medal Results' inline='true' name='federated.medal_analysis' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='medal_results' name='textscan.medal_results'>
            <connection class='textscan' directory='c:/Users/Hp/Desktop/olympic' filename='medal_results.csv' password='' server='' />
          </named-connection>
          <named-connection caption='games_summary' name='textscan.games_summary'>
            <connection class='textscan' directory='c:/Users/Hp/Desktop/olympic' filename='games_summary.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.medal_results' name='medal_results.csv' table='[medal_results#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='integer' name='year' ordinal='0' />
            <column datatype='string' name='host_city' ordinal='1' />
            <column datatype='string' name='host_country' ordinal='2' />
            <column datatype='string' name='season' ordinal='3' />
            <column datatype='string' name='country' ordinal='4' />
            <column datatype='string' name='noc_code' ordinal='5' />
            <column datatype='string' name='region' ordinal='6' />
            <column datatype='string' name='gdp_tier' ordinal='7' />
            <column datatype='integer' name='population_million' ordinal='8' />
            <column datatype='string' name='sports_investment' ordinal='9' />
            <column datatype='integer' name='athletes_sent' ordinal='10' />
            <column datatype='integer' name='gold' ordinal='11' />
            <column datatype='integer' name='silver' ordinal='12' />
            <column datatype='integer' name='bronze' ordinal='13' />
            <column datatype='integer' name='total_medals' ordinal='14' />
            <column datatype='integer' name='medal_points' ordinal='15' />
            <column datatype='real' name='medal_efficiency_pct' ordinal='16' />
            <column datatype='string' name='top_sport' ordinal='17' />
            <column datatype='integer' name='host_nation' ordinal='18' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Host Country' datatype='string' name='[host_country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Host City' datatype='string' name='[host_city]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column caption='NOC Code' datatype='string' name='[noc_code]' role='dimension' type='nominal' />
      <column caption='Region' datatype='string' name='[region]' role='dimension' type='nominal' />
      <column caption='Season' datatype='string' name='[season]' role='dimension' type='nominal' />
      <column caption='Year' datatype='integer' name='[year]' role='dimension' type='ordinal' />
      <column caption='Gold Medals' datatype='integer' name='[gold]' role='measure' type='quantitative' />
      <column caption='Silver Medals' datatype='integer' name='[silver]' role='measure' type='quantitative' />
      <column caption='Bronze Medals' datatype='integer' name='[bronze]' role='measure' type='quantitative' />
      <column caption='Total Medals' datatype='integer' name='[total_medals]' role='measure' type='quantitative' />
      <column caption='Medal Points' datatype='integer' name='[medal_points]' role='measure' type='quantitative' />
      <column caption='Medal Efficiency Pct' datatype='real' name='[medal_efficiency_pct]' role='measure' type='quantitative' />
      <column caption='Athletes Sent' datatype='integer' name='[athletes_sent]' role='measure' type='quantitative' />
      <column caption='Host Nation Flag' datatype='integer' name='[host_nation]' role='dimension' type='ordinal' />
      <column caption='Host Nation (Corrected)' datatype='integer' name='[Calculation_HostNation_Fixed]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='IF [country] = [host_country] OR ([country] = &quot;Great Britain&quot; AND [host_country] = &quot;United Kingdom&quot;) THEN 1 ELSE 0 END' />
      </column>
      <column caption='Games Edition' datatype='string' name='[Calculation_Games_Edition]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[host_city] + &quot; &quot; + STR([year]) + &quot; (&quot; + [season] + &quot;)&quot;' />
      </column>
      <column caption='Weighted Efficiency Ratio' datatype='real' name='[Calculation_Weighted_Efficiency]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([medal_points]) / SUM([athletes_sent])' />
      </column>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='%null%' />
      </semantic-values>
    </datasource>

    <datasource caption='Olympic Athletes' inline='true' name='federated.athletes' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='athletes' name='textscan.athletes'>
            <connection class='textscan' directory='c:/Users/Hp/Desktop/olympic' filename='athletes.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.athletes' name='athletes.csv' table='[athletes#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='athlete_id' ordinal='0' />
            <column datatype='string' name='name' ordinal='1' />
            <column datatype='string' name='gender' ordinal='2' />
            <column datatype='integer' name='age_at_peak' ordinal='3' />
            <column datatype='string' name='country' ordinal='4' />
            <column datatype='string' name='noc_code' ordinal='5' />
            <column datatype='string' name='region' ordinal='6' />
            <column datatype='string' name='sport' ordinal='7' />
            <column datatype='string' name='sport_category' ordinal='8' />
            <column datatype='string' name='season' ordinal='9' />
            <column datatype='integer' name='first_games_year' ordinal='10' />
            <column datatype='integer' name='last_games_year' ordinal='11' />
            <column datatype='integer' name='games_participated' ordinal='12' />
            <column datatype='integer' name='gold_medals' ordinal='13' />
            <column datatype='integer' name='silver_medals' ordinal='14' />
            <column datatype='integer' name='bronze_medals' ordinal='15' />
            <column datatype='integer' name='total_medals' ordinal='16' />
            <column datatype='integer' name='world_record_holder' ordinal='17' />
            <column datatype='integer' name='personal_best_rank_world' ordinal='18' />
            <column datatype='integer' name='height_cm' ordinal='19' />
            <column datatype='integer' name='weight_kg' ordinal='20' />
            <column datatype='real' name='bmi' ordinal='21' />
            <column datatype='integer' name='training_hours_per_week' ordinal='22' />
            <column datatype='integer' name='professional_athlete' ordinal='23' />
            <column datatype='integer' name='doping_violation' ordinal='24' />
            <column datatype='integer' name='most_recent_medal_2020plus' ordinal='25' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Athlete ID' datatype='string' name='[athlete_id]' role='dimension' type='nominal' />
      <column caption='Name' datatype='string' name='[name]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Sport' datatype='string' name='[sport]' role='dimension' type='nominal' />
      <column caption='Sport Category' datatype='string' name='[sport_category]' role='dimension' type='nominal' />
      <column caption='Height (cm)' datatype='integer' name='[height_cm]' role='measure' type='quantitative' />
      <column caption='Weight (kg)' datatype='integer' name='[weight_kg]' role='measure' type='quantitative' />
      <column caption='BMI' datatype='real' name='[bmi]' role='measure' type='quantitative' />
      <column caption='BMI Category' datatype='string' name='[Calculation_BMI_Category]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [bmi] &lt; 18.5 THEN &quot;Underweight&quot; ELSEIF [bmi] &lt; 25.0 THEN &quot;Normal Weight&quot; ELSEIF [bmi] &lt; 30.0 THEN &quot;Overweight&quot; ELSE &quot;Obese&quot; END' />
      </column>
      <column caption='Career Longevity Tier' datatype='string' name='[Calculation_Career_Longevity]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [games_participated] = 1 THEN &quot;1 Edition (Debut)&quot; ELSEIF [games_participated] = 2 THEN &quot;2 Editions (Returning)&quot; ELSE &quot;3+ Editions (Veteran)&quot; END' />
      </column>
      <layout dim-ordering='alphabetic' dim-percentage='0.5' measure-ordering='alphabetic' measure-percentage='0.5' show-structure='true' />
    </datasource>

    <datasource caption='All-Time Country Rankings' inline='true' name='federated.alltime_rankings' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='alltime_country_rankings' name='textscan.alltime_country_rankings'>
            <connection class='textscan' directory='c:/Users/Hp/Desktop/olympic' filename='alltime_country_rankings.csv' password='' server='' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.alltime_country_rankings' name='alltime_country_rankings.csv' table='[alltime_country_rankings#csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='country' ordinal='0' />
            <column datatype='string' name='noc_code' ordinal='1' />
            <column datatype='string' name='region' ordinal='2' />
            <column datatype='integer' name='games_entered' ordinal='3' />
            <column datatype='integer' name='total_gold' ordinal='4' />
            <column datatype='integer' name='total_silver' ordinal='5' />
            <column datatype='integer' name='total_bronze' ordinal='6' />
            <column datatype='integer' name='total_medals' ordinal='7' />
            <column datatype='integer' name='total_medal_points' ordinal='8' />
            <column datatype='real' name='avg_efficiency_pct' ordinal='9' />
            <column datatype='integer' name='summer_medals' ordinal='10' />
            <column datatype='integer' name='winter_medals' ordinal='11' />
            <column datatype='integer' name='overall_rank' ordinal='12' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
      <column caption='Overall Rank' datatype='integer' name='[overall_rank]' role='dimension' type='ordinal' />
      <column caption='All-Time Total Medals' datatype='integer' name='[total_medals]' role='measure' type='quantitative' />
      <column caption='All-Time Total Gold' datatype='integer' name='[total_gold]' role='measure' type='quantitative' />
      <column caption='All-Time Total Points' datatype='integer' name='[total_medal_points]' role='measure' type='quantitative' />
    </datasource>
  </datasources>

  <worksheets>
    <worksheet name='Olympic Overview KPIs'>
      <table>
        <view>
          <datasources>
            <datasource caption='Olympic Games and Medal Results' name='federated.medal_analysis' />
          </datasources>
          <datasource-dependencies datasource='federated.medal_analysis'>
            <column datatype='integer' name='[gold]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_medals]' role='measure' type='quantitative' />
            <column-instance column='[gold]' derivation='Sum' name='[sum:gold:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_medals]' derivation='Sum' name='[sum:total_medals:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.medal_analysis].[sum:total_medals:qk]</rows>
        <cols>[federated.medal_analysis].[sum:gold:qk]</cols>
      </table>
      <simple-id uuid='{C107CA39-EB4A-4A13-9C7E-73CE6379B42B}' />
    </worksheet>

    <worksheet name='Top 10 Countries by Total Medals'>
      <table>
        <view>
          <datasources>
            <datasource caption='Olympic Games and Medal Results' name='federated.medal_analysis' />
          </datasources>
          <datasource-dependencies datasource='federated.medal_analysis'>
            <column datatype='string' name='[country]' role='dimension' semantic-role='[Country].[Name]' type='nominal' />
            <column datatype='integer' name='[medal_points]' role='measure' type='quantitative' />
            <column datatype='integer' name='[total_medals]' role='measure' type='quantitative' />
            <column-instance column='[country]' derivation='None' name='[none:country:nk]' pivot='key' type='nominal' />
            <column-instance column='[medal_points]' derivation='Sum' name='[sum:medal_points:qk]' pivot='key' type='quantitative' />
            <column-instance column='[total_medals]' derivation='Sum' name='[sum:total_medals:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Bar' />
            <encodings>
              <color column='[federated.medal_analysis].[sum:medal_points:qk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.medal_analysis].[none:country:nk]</rows>
        <cols>[federated.medal_analysis].[sum:total_medals:qk]</cols>
      </table>
      <simple-id uuid='{9F1E6171-ECF2-434B-AAAE-62DFE0A0A0A5}' />
